### create address, anonymous (pre-registration bootstrap — not linked to any user)

POST {{baseUrl}}
Content-Type: application/json

{
    "location": "https://share.google/UCp92LzP4tQFfHXke",
    "region": "Al-Batinah",
    "city": "Masnaah"
}

### create address, authenticated SUPPLIER/RETAILER (linked onto the caller's own account)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "location": "https://share.google/UCp92LzP4tQFfHXke",
    "region": "Al-Batinah",
    "city": "Masnaah"
}

### create address, ADMIN on behalf of a user (user_ref required; 400 without it, 404 if the user doesn't exist)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "location": "https://share.google/UCp92LzP4tQFfHXke",
    "region": "Al-Batinah",
    "city": "Masnaah",
    "user_ref": {{targetUserId}}
}

### list addresses (ADMIN sees all; SUPPLIER/RETAILER only their own)

GET {{baseUrl}}
Authorization: Bearer {{accessToken}}

### get address by id (own address, or any address for ADMIN)

GET {{baseUrl}}/{{addressId}}
Authorization: Bearer {{accessToken}}

### update address (own address for SUPPLIER/RETAILER, any address for ADMIN)

PATCH {{baseUrl}}/{{addressId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "location": "https://maps.app.goo.gl/Ly51Sz3Zp5JpLqyS9",
    "region": "Al-batinah",
    "city": "AboAbali"
}

### delete address (own address for SUPPLIER/RETAILER, any address for ADMIN)

DELETE {{baseUrl}}/{{addressId}}
Authorization: Bearer {{accessToken}}

#   location: { type: String, required: true },
#   region: { type: String, required: true },
#   city: { type: String, required: true },