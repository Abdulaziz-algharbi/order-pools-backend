@baseUrl=http://localhost:8000/api/v1/pools
@poolId=REPLACE_WITH_POOL_ID
@productOfferId=REPLACE_WITH_PRODUCT_OFFER_ID
@adminAccessToken=REPLACE_WITH_ADMIN_ACCESS_TOKEN
@supplierAccessToken=REPLACE_WITH_SUPPLIER_ACCESS_TOKEN

# See 00-smooth-flow.http for a chained run that creates a real offer/pool/
# tokens end to end instead of hand-editing the placeholders above.

### create pool (ADMIN only)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "productoffer_ref": "{{productOfferId}}",
    "currentQuantity": 70,
    "minimumContribution": 10,
    "pricePerUnit": 1,
    "endDate": "2026-08-29T14:30:00Z"
}

### list pools, anonymous or RETAILER (only OPEN pools)

GET {{baseUrl}}

### list pools, SUPPLIER (only pools built from their own products, any status)

GET {{baseUrl}}
Authorization: Bearer {{supplierAccessToken}}

### list pools, ADMIN (every pool)

GET {{baseUrl}}
Authorization: Bearer {{adminAccessToken}}

### get pool by id

GET {{baseUrl}}/{{poolId}}

### update pool (ADMIN only)

PATCH {{baseUrl}}/{{poolId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "minimumContribution": 12,
    "pricePerUnit": 7
}

### mark a pool as having reached its target (ADMIN only) — required before
### a delivery can be created for it (see deliveries.http)

PATCH {{baseUrl}}/{{poolId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "status": "TARGET_REACHED"
}

### reopen a CANCELLED pool back to OPEN (ADMIN only) — resets startDate as the collection window restarts

PATCH {{baseUrl}}/{{poolId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "status": "OPEN"
}

### delete pool (ADMIN only)

DELETE {{baseUrl}}/{{poolId}}
Authorization: Bearer {{adminAccessToken}}
