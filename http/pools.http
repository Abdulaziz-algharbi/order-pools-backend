### create pool (ADMIN only)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "productoffer_ref": {{productOfferId}},
    "currentQuantity": 70,
    "minimumContribution": 10,
    "pricePerUnit": 1,
    "endDate": "2026-08-29T14:30:00Z"
}

### list pools, anonymous or RETAILER (only OPEN pools)

GET {{baseUrl}}

### list pools, SUPPLIER (only pools built from their own products, any status)

GET {{baseUrl}}
Authorization: Bearer {{supplierAccessToken}}

### list pools, ADMIN (every pool)

GET {{baseUrl}}
Authorization: Bearer {{adminAccessToken}}

### get pool by id

GET {{baseUrl}}/{{poolId}}

### update pool (ADMIN only)

PATCH {{baseUrl}}/{{poolId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "minimumContribution": 12,
    "pricePerUnit": 7
}

### delete pool (ADMIN only)

DELETE {{baseUrl}}/{{poolId}}
Authorization: Bearer {{adminAccessToken}}


#     productoffer_ref: {
#       type: Types.ObjectId,
#       ref: 'ProductOffer',
#       required: true,
#     },
#     currentQuantity: { type: Number, required: true },
#     minimumContribution: { type: Number, required: true },
#     pricePerUnit: { type: Number, required: true },
#     endDate: { type: Date, required: true },