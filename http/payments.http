@baseUrl=http://localhost:8000/api/v1/payments
@paymentId=REPLACE_WITH_PAYMENT_ID
@userID=REPLACE_WITH_USER_ID

# This route has no auth/role checks wired up yet — anyone can create a
# payment for any user_ref. See 00-smooth-flow.http for a chained run
# that creates a real user/payment end to end.
### create payment

POST {{baseUrl}}
Content-Type: application/json

{
    "user_ref": "{{userID}}",
    "transactionReference": "s3 urls",
    "amount": 50,
    "stripePaymentIntentId": "stripe id"
}

### list payments

GET {{baseUrl}}

### get payment by id

GET {{baseUrl}}/{{paymentId}}

### update payment

PATCH {{baseUrl}}/{{paymentId}}
Content-Type: application/json

{
    "amount": 60
}

### delete payment

DELETE {{baseUrl}}/{{paymentId}}