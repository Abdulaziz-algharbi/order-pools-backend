@baseUrl=http://localhost:8000/api/v1/payments
@paymentId=6a86e66b698536e9980baa15
@userID="6a71c282ec9d84c27d309e8d"


### create payment

POST {{baseUrl}}
Content-Type: application/json

{
    "user_ref": {{userID}},
    "transactionReference": "s3 urls",
    "amount": 50,
    "stripePaymentIntentId": "stripe id"
}

### list payments

GET {{baseUrl}}

### get payment by id

GET {{baseUrl}}/{{paymentId}}

### update payment

PATCH {{baseUrl}}/{{paymentId}}
Content-Type: application/json

{
    "amount": 60
}

### delete payment

DELETE {{baseUrl}}/{{paymentId}}



