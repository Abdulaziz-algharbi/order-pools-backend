@baseUrl=http://localhost:8000/api/v1/users
@userId=REPLACE_WITH_USER_ID
@addressIds=["REPLACE_WITH_ADDRESS_ID_1", "REPLACE_WITH_ADDRESS_ID_2"]
@adminToken=REPLACE_WITH_ADMIN_ACCESS_TOKEN

# This module is ADMIN only end to end. Retailers/suppliers register, log
# in, refresh, and read their own info via /auth instead — see auth.http.
# See 00-smooth-flow.http for a chained run that creates real addresses/
# tokens end to end instead of hand-editing the placeholders above.

### create user (ADMIN only; roles defaults to ["RETAILER"] if omitted)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "roles": ["SUPPLIER"],
  "firstName": "supplier",
  "lastName": "test",
  "email": "supplierTest2@two.com",
  "phoneNumber": "91149027",
  "companyName": "supplier company",
  "password": "suppliertest",
  "addresses": {{addressIds}}
}

### get all users (ADMIN only)

GET {{baseUrl}}
Authorization: Bearer {{adminToken}}

### get user by id (ADMIN only)

GET {{baseUrl}}/{{userId}}
Authorization: Bearer {{adminToken}}

### update user (ADMIN only; roles may be set directly here too)

PATCH {{baseUrl}}/{{userId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "firstName": "Updated",
  "lastName": "User",
  "companyName": "Updated Company"
}

### delete user (ADMIN only)
DELETE {{baseUrl}}/{{userId}}
Authorization: Bearer {{adminToken}}
