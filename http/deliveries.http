@baseUrl=http://localhost:8000/api/v1/deliveries
@deliveryId=6a86e30a1ae6373324cdc94f
@poolId="6a86e28d5cd9e412c490d787"
@accessToken=""

### create delivery (ADMIN only — pool must be TARGET_REACHED/DISTRIBUTING/COMPLETED, one per pool)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "pool_ref": {{poolId}}
}

### list deliveries (ADMIN sees all; RETAILER sees pools they joined; SUPPLIER sees pools built from their products)

GET {{baseUrl}}
Authorization: Bearer {{accessToken}}

### get delivery by id

GET {{baseUrl}}/{{deliveryId}}
Authorization: Bearer {{accessToken}}

### update delivery (ADMIN only)

PATCH {{baseUrl}}/{{deliveryId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "deliveryStatus": "DELIVERED"
}

### delete delivery (ADMIN only)

DELETE {{baseUrl}}/{{deliveryId}}
Authorization: Bearer {{accessToken}}

