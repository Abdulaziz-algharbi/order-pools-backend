
@baseUrl = http://localhost:8000/api/v1/auth
@addressIds=["REPLACE_WITH_ADDRESS_ID_1", "REPLACE_WITH_ADDRESS_ID_2"]

# addressIds must reference addresses that already exist — create them via
# addresses.http first (or run 00-smooth-flow.http for a fully chained
# register -> login -> me -> refresh example with fresh throwaway users).

### register a new user
POST {{baseUrl}}/register
Content-Type: application/json

{
  "firstName": "Abo",
  "lastName": "Omar",
  "email": "abdulazizalgharbi8@gmail.com",
  "phoneNumber": "91149027",
  "companyName": "sys admin",
  "password": "Azaz23456",
  "addresses": {{addressIds}}
}

### login with the registered user
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "abdulazizalgharbi8@gmail.com",
  "password": "Azaz23456"
}

###

@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

### me
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

### refresh token

POST  {{baseUrl}}/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
