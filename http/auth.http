
@baseUrl = http://localhost:8000/api/v1/auth
@addressIds=["6a731fd174b4f84b4767e2a8", "6a7c2ad3f389f6ed96dc98e5"]


### register a new user
POST {{baseUrl}}/register
Content-Type: application/json

{
  "firstName": "retailer15",
  "lastName": "smith1113",
  "email": "202311280@gcet.edu.om",
  "phoneNumber": "1911419027",
  "companyName": "small retailer",
  "password": "retailerpassword",
  "addresses": {{addressIds}}
}

### login with the registered user
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "six@three.test",
  "password": "retailerpassword"
}

###

@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

### me
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

### refresh token

POST  {{baseUrl}}/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
