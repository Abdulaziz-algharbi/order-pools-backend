@baseUrl=http://localhost:8000/api/v1/offers
@productOfferId=6a86e87537758866e94b8ab8
@supplierToken=REPLACE_WITH_SUPPLIER_ACCESS_TOKEN
@adminToken=REPLACE_WITH_ADMIN_ACCESS_TOKEN


### create productOffer (SUPPLIER only; user_ref is taken from the token)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{supplierToken}}

{
    "name": "Basmati Rice 25kg",
    "description": "Long-grain basmati rice, wholesale sack",
    "brand": "Al Reef",
    "unit": "CARTON",
    "wholeQuantity": 500,
    "price": 20
}

### list productOffer (SUPPLIER: own offers only; ADMIN: all)

GET {{baseUrl}}
Authorization: Bearer {{supplierToken}}

### get productOffer by id (SUPPLIER: own only; ADMIN: any)

GET {{baseUrl}}/{{productOfferId}}
Authorization: Bearer {{supplierToken}}

### update productOffer as SUPPLIER (wholeQuantity/price only, own offer)

PATCH {{baseUrl}}/{{productOfferId}}
Content-Type: application/json
Authorization: Bearer {{supplierToken}}

{
    "wholeQuantity": 50,
    "price": 7
}

### update productOffer as ADMIN (status/adminComment only)

PATCH {{baseUrl}}/{{productOfferId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "REJECTED",
    "adminComment": "Price too high for current market"
}

### delete productOffer (SUPPLIER: own only; ADMIN: any; REJECTED offers also auto-delete after 7 days)

DELETE {{baseUrl}}/{{productOfferId}}
Authorization: Bearer {{supplierToken}}
