@baseUrl=http://localhost:8000/api/v1/complaints
@complaintId=REPLACE_WITH_COMPLAINT_ID
@poolId=REPLACE_WITH_POOL_ID
@accessToken=REPLACE_WITH_RETAILER_OR_SUPPLIER_ACCESS_TOKEN
@adminAccessToken=REPLACE_WITH_ADMIN_ACCESS_TOKEN

# See 00-smooth-flow.http for a chained run that creates a real pool/token
# end to end instead of hand-editing the placeholders above.

### create complaint (RETAILER or SUPPLIER only — creator_ref is derived from the token, not sent; ADMIN gets 403)

POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "pool_ref": "{{poolId}}",
    "title": "not the agreed number anothor retailer",
    "description": "I bought 20 pieces, but I got 25"
}

### list complaintes

GET {{baseUrl}}
Authorization: Bearer {{accessToken}}

### get complaint by id

GET {{baseUrl}}/{{complaintId}}
Authorization: Bearer {{accessToken}}

### update complaint, owner (title/description/priority only — status and resolution are silently ignored)

PATCH {{baseUrl}}/{{complaintId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "title": "I Received different product",
    "description": "I ordered rice but got lemon!"
}

### update complaint, ADMIN (any field, including status/resolution, whoever filed it)

PATCH {{baseUrl}}/{{complaintId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
    "status": "RESOLVED",
    "resolution": "Refunded the retailer for the 5 extra pieces."
}

### delete complaint (ADMIN only)

DELETE {{baseUrl}}/{{complaintId}}
Authorization: Bearer {{adminAccessToken}}
