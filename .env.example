PORT=
# DEV | STAGING | PROD
APP_MODE=

DEV_MONGO_URI=
STAGIN_MONGO_URI=
PROD_MONGO_URI=

# frontend origin allowed via CORS; defaults to http://localhost:5173 if unset
FRONTEND_URL=

JWT_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# used only by `npm run seed:admins` (see scripts/seed-admins.ts) — never
# read by the running app. Optional _FIRST_NAME/_LAST_NAME/_PHONE overrides
# also exist per admin; see the script header.
SEED_ADMIN_1_EMAIL=
SEED_ADMIN_1_PASSWORD=
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_PASSWORD=